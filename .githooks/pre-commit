#!/bin/sh
# Refuse to commit medical images.
#
# Test data for this project is real patient imaging. It lives outside the
# repository and must stay there. .gitignore alone is not enough: `git add -f`
# and a mistyped path both walk straight past it, and a DICOM file whose name
# gives nothing away is indistinguishable from a fixture until someone opens
# it. So files are identified by what they contain, not what they are called.
#
# The scan runs in one process. An earlier version spawned `dd` per file, which
# is fine for a handful and takes minutes once the conformance corpus is
# staged — and a hook slow enough to be worked around is a hook that will be.
#
# The Python path asks git for the file list itself rather than receiving it on
# stdin: `python - <<EOF` already spends stdin on the script, so a piped list
# arrives empty and every check silently passes. That version was written and
# caught by a decoy file, which is why tests/test_hook.py now exists.

set -e

for python in python3 python py; do
    if command -v "$python" >/dev/null 2>&1; then
        "$python" "$(dirname "$0")/scan_staged.py"
        exit $?
    fi
done

# No Python. Refuse.
#
# There used to be a shell fallback here. It checked the part-10 preamble and
# three extensions, and nothing else — so a raw DICOM file with no preamble
# walked past it, and a file it could not read was treated as clean. That is
# the same shape as the CI copy that had to be deleted: a second, weaker
# implementation of a rule, which is the one that runs when it matters.
#
# Python is required to develop this project at all. If it is missing, the
# commit stops rather than proceeding on a check that cannot be trusted.
printf '
No Python interpreter found, so the medical-image scan cannot run.
'
printf 'Refusing rather than allowing an unchecked commit.

'
exit 2
